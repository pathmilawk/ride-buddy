# Ride Buddy - environment variables
#
# Assumption A-3: you provision the Supabase project and supply these values.
# Copy this file to .env.local and fill it in from your Supabase project
# (Project Settings -> API Keys).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co


# The browser-safe publishable key, shown as "Publishable key" and starting sb_publishable_.
# It replaces what Supabase used to call the anon key. Safe to expose: it carries no privileges
# of its own, and every request made with it is subject to the row level security policies in
# supabase/migrations/.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# If your project predates the key migration and only shows an "anon public" key, set this
# instead and leave the line above unset - the app reads it as a fallback.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# No secret key (formerly service_role) is needed by the application, and none should be added.
# It bypasses every RLS policy. Authorization here runs as the signed-in user against the
# policies in supabase/migrations/ - see NFR-1. A secret key must never carry a NEXT_PUBLIC_
# prefix.

# ---------------------------------------------------------------------------
# Applying the schema - needed ONCE, by `npm run db:push`, not by the app
# ---------------------------------------------------------------------------
# Creating tables, functions, triggers and policies needs direct database access. The
# publishable key cannot do it: it maps to the 'anon' role, which has no DDL rights. Nor can a
# secret key - PostgREST does not expose DDL at all.
#
# Set this ONLY if you want `npm run db:push` to apply the migrations for you. The application
# itself never reads it, and it has no NEXT_PUBLIC_ prefix, so it never reaches the browser.
#
# Supabase -> Project Settings -> Database -> Database password (or Connection string -> URI).
#
# SUPABASE_DB_URL=postgresql://postgres:YOUR-DB-PASSWORD@db.your-project-ref.supabase.co:5432/postgres
#
# If you would rather not store a database password at all, skip this and paste
# aidlc-docs/construction/build-and-test/complete-schema.sql into the Supabase SQL Editor.
